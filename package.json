{
  "name": "tuari_react_hono",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "check:web-hygiene": "node --test ./tests/web-hygiene.test.mjs",
    "check:workflow-assets": "node --test ./tests/workflow-assets.test.mjs",
    "check:web-tracking": "node ./scripts/check-web-tracking.mjs",
    "predev": "pnpm check:web-tracking && pnpm --filter @tuari/contracts build",
    "dev": "pnpm -r --parallel --filter @tuari/contracts --filter @tuari/api --filter @tuari/web dev",
    "build": "pnpm check:web-tracking && turbo build",
    "lint": "pnpm check:web-tracking && pnpm check:web-hygiene && pnpm check:workflow-assets && turbo lint",
    "test": "pnpm check:web-tracking && pnpm check:web-hygiene && pnpm check:workflow-assets && turbo test",
    "test:api": "pnpm --filter @tuari/contracts build && pnpm --filter @tuari/api test",
    "test:contracts": "pnpm --filter @tuari/contracts test",
    "test:web": "pnpm --filter @tuari/web test",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "typecheck": "pnpm check:web-tracking && turbo typecheck",
    "dev:web": "pnpm check:web-tracking && pnpm --filter @tuari/web dev",
    "dev:api": "pnpm check:web-tracking && pnpm --filter @tuari/contracts build && pnpm --filter @tuari/api dev",
    "dev:desktop": "pnpm --filter @tuari/desktop dev",
    "build:desktop": "pnpm --filter @tuari/desktop build",
    "portable:desktop": "pnpm --filter @tuari/desktop portable"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "prisma"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^28.1.0",
    "turbo": "^2.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
