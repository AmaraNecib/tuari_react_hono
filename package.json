{
  "name": "tuari_react_hono",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "check:web-tracking": "node ./scripts/check-web-tracking.mjs",
    "predev": "pnpm check:web-tracking && pnpm --filter @tuari/contracts build",
    "dev": "pnpm -r --parallel --filter @tuari/contracts --filter @tuari/api --filter @tuari/web dev",
    "build": "pnpm check:web-tracking && turbo build",
    "lint": "pnpm check:web-tracking && turbo lint",
    "typecheck": "pnpm check:web-tracking && turbo typecheck",
    "dev:web": "pnpm check:web-tracking && pnpm --filter @tuari/web dev",
    "dev:api": "pnpm --filter @tuari/api dev",
    "dev:desktop": "pnpm --filter @tuari/desktop dev",
    "build:desktop": "pnpm --filter @tuari/desktop build",
    "portable:desktop": "pnpm --filter @tuari/desktop portable"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "prisma"
    ]
  },
  "devDependencies": {
    "turbo": "^2.8.16",
    "typescript": "^5.9.3"
  }
}
