{
  "name": "@tuari/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth.ts --output ./prisma/schema.prisma --yes",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.5.5",
    "@hono/node-server": "^1.19.6",
    "@orpc/server": "^1.13.6",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@tuari/contracts": "workspace:*",
    "better-auth": "^1.5.5",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "hono": "^4.10.4",
    "prisma": "^7.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.17",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  }
}
