generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum SalaryPeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                  String    @id
  name                String
  image               String?
  phoneNumber         String    @unique
  phoneNumberVerified Boolean   @default(false)
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")
  sessions            Session[]
  accounts            Account[]
  profileHistory      UserProfileHistory[]

  @@map("user")
}

model UserProfileHistory {
  id            String   @id
  userId        String   @map("user_id")
  name          String?
  phone         String?
  previousName  String?  @map("previous_name")
  previousPhone String?  @map("previous_phone")
  passwordChanged Boolean @default(false) @map("password_changed")
  actorUserId   String?  @map("actor_user_id")
  actorLabel    String?  @map("actor_label")
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("user_profile_history")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

model Role {
  id                     String                 @id
  key                    String                 @unique
  name                   String
  description            String?
  isSystem               Boolean                @default(false) @map("is_system")
  createdAt              DateTime               @map("created_at")
  updatedAt              DateTime               @map("updated_at")
  employees              Employee[]
  employeeStateHistories EmployeeStateHistory[]

  @@map("role")
}

model Employee {
  id                          String                             @id
  firstName                   String                             @map("first_name")
  lastName                    String                             @map("last_name")
  phone                       String                             @unique
  roleId                      String                             @map("role_id")
  status                      String
  salaryAmountDzd             Float?                             @map("salary_amount_dzd")
  salaryPeriod                String?                            @map("salary_period")
  notes                       String?
  createdAt                   DateTime                           @map("created_at")
  updatedAt                   DateTime                           @map("updated_at")
  role                        Role                               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  managedProjects             Project[]                          @relation("ProjectManager")
  managedWarehouses           Warehouse[]                        @relation("WarehouseManager")
  managerAssignmentsAsWorker  EmployeeManagerAssignment[]        @relation("WorkerAssignments")
  managerAssignmentsAsManager EmployeeManagerAssignment[]        @relation("ManagerAssignments")
  projectAssignments          EmployeeProjectAssignment[]
  warehouseAssignments        EmployeeWarehouseAssignment[]
  stateHistory                EmployeeStateHistory[]
  managedProjectHistory       ProjectManagerOwnershipHistory[]   @relation("ProjectManagementOwner")
  managedWarehouseHistory     WarehouseManagerOwnershipHistory[] @relation("WarehouseManagementOwner")
  salaryPayments              EmployeeSalaryPayment[]
  debtAccounts                DebtAccount[]

  @@index([roleId])
  @@map("employee")
}

model EmployeeManagerAssignment {
  id        String    @id
  workerId  String    @map("worker_id")
  managerId String    @map("manager_id")
  status    String
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  notes     String?
  actorUserId   String?   @map("actor_user_id")
  actorLabel    String?   @map("actor_label")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  worker        Employee  @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: Restrict)
  manager       Employee  @relation("ManagerAssignments", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([workerId])
  @@index([managerId])
  @@map("employee_manager_assignment")
}

model Project {
  id                  String                           @id
  name                String
  location            String?
  managerId           String?                          @map("manager_id")
  status              String
  notes               String?
  createdAt           DateTime                         @map("created_at")
  updatedAt           DateTime                         @map("updated_at")
  manager             Employee?                        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  employeeAssignments EmployeeProjectAssignment[]
  managerHistory      ProjectManagerOwnershipHistory[]
  inventoryInvoiceGroups InventoryInvoiceGroup[]      @relation("InventoryInvoiceGroupProject")
  inventoryEntries      InventoryEntry[]              @relation("InventoryEntryProject")

  @@index([managerId])
  @@map("project")
}

model EmployeeProjectAssignment {
  id         String    @id
  employeeId String    @map("employee_id")
  projectId  String    @map("project_id")
  status     String
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  notes      String?
  actorUserId   String?   @map("actor_user_id")
  actorLabel    String?   @map("actor_label")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([projectId])
  @@map("employee_project_assignment")
}

model Warehouse {
  id                  String                             @id
  name                String
  address             String?                            @map("address")
  managerId           String?                            @map("manager_id")
  status              String
  notes               String?
  createdAt           DateTime                           @map("created_at")
  updatedAt           DateTime                           @map("updated_at")
  manager             Employee?                          @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  employeeAssignments EmployeeWarehouseAssignment[]
  managerHistory      WarehouseManagerOwnershipHistory[]
  inventoryInvoiceGroups InventoryInvoiceGroup[]         @relation("InventoryInvoiceGroupWarehouse")
  inventoryEntries      InventoryEntry[]                 @relation("InventoryEntryWarehouse")

  @@index([managerId])
  @@map("warehouse")
}

model EmployeeWarehouseAssignment {
  id          String    @id
  employeeId  String    @map("employee_id")
  warehouseId String    @map("warehouse_id")
  status      String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  notes       String?
  actorUserId   String?   @map("actor_user_id")
  actorLabel    String?   @map("actor_label")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([warehouseId])
  @@map("employee_warehouse_assignment")
}

model EmployeeStateHistory {
  id              String    @id
  employeeId      String    @map("employee_id")
  roleId          String    @map("role_id")
  status          String
  salaryAmountDzd Float?    @map("salary_amount_dzd")
  salaryPeriod    String?   @map("salary_period")
  eventType       String    @map("event_type")
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  notes           String?
  actorUserId     String?   @map("actor_user_id")
  actorLabel      String?   @map("actor_label")
  transactionId   String?   @map("transaction_id")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([employeeId, endDate])
  @@map("employee_state_history")
}

model ProjectManagerOwnershipHistory {
  id        String    @id
  projectId String    @map("project_id")
  managerId String    @map("manager_id")
  status    String
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  notes     String?
  actorUserId   String?   @map("actor_user_id")
  actorLabel    String?   @map("actor_label")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  manager       Employee  @relation("ProjectManagementOwner", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([projectId, startDate])
  @@index([managerId, startDate])
  @@map("project_manager_ownership_history")
}

model WarehouseManagerOwnershipHistory {
  id          String    @id
  warehouseId String    @map("warehouse_id")
  managerId   String    @map("manager_id")
  status      String
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  notes       String?
  actorUserId   String?   @map("actor_user_id")
  actorLabel    String?   @map("actor_label")
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  manager       Employee  @relation("WarehouseManagementOwner", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([warehouseId, startDate])
  @@index([managerId, startDate])
  @@map("warehouse_manager_ownership_history")
}

model EmployeeSalaryPayment {
  id                String           @id
  employeeId        String           @map("employee_id")
  periodType        SalaryPeriodType @map("period_type")
  expectedAmountDzd Float            @map("expected_amount_dzd")
  actualAmountDzd   Float            @map("actual_amount_dzd")
  paymentDate       DateTime         @map("payment_date")
  note              String?          @map("note")
  actorUserId       String?          @map("actor_user_id")
  actorLabel        String?          @map("actor_label")
  transactionId     String?          @map("transaction_id")
  createdAt         DateTime         @map("created_at")
  updatedAt         DateTime         @map("updated_at")
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, paymentDate])
  @@index([employeeId, periodType, paymentDate])
  @@map("employee_salary_payment")
}

model ExternalCounterparty {
  id           String        @id
  fullName     String        @map("full_name")
  phoneNumber  String        @map("phone_number")
  note         String?
  createdAt    DateTime      @map("created_at")
  updatedAt    DateTime      @map("updated_at")
  debtAccounts DebtAccount[]

  @@index([fullName])
  @@map("external_counterparty")
}

model DebtAccount {
  id                     String                @id
  partyType              String                @map("party_type")
  workerId               String?               @map("worker_id")
  externalCounterpartyId String?               @map("external_counterparty_id")
  status                 String
  direction              String                @default("PAYABLE") @map("direction")
  currentBalance          Float                 @default(0) @map("current_balance")
  note                   String?
  settledAt              DateTime?             @map("settled_at")
  actorUserId            String?               @map("actor_user_id")
  actorLabel             String?               @map("actor_label")
  transactionId          String?               @map("transaction_id")
  createdAt              DateTime              @map("created_at")
  updatedAt              DateTime              @map("updated_at")
  worker                 Employee?             @relation(fields: [workerId], references: [id], onDelete: Restrict)
  externalCounterparty   ExternalCounterparty? @relation(fields: [externalCounterpartyId], references: [id], onDelete: Restrict)
  entries                DebtEntry[]

  @@index([workerId])
  @@index([externalCounterpartyId])
  @@map("debt_account")
}

model DebtEntry {
  id             String      @id
  debtAccountId  String      @map("debt_account_id")
  entryType      String      @map("entry_type")
  signedAmountDzd Float      @map("signed_amount_dzd")
  entryDate      DateTime    @map("entry_date")
  note           String?
  balanceAfterDzd Float      @map("balance_after_dzd")
  actorUserId    String?     @map("actor_user_id")
  actorLabel     String?     @map("actor_label")
  transactionId  String?     @map("transaction_id")
  createdAt      DateTime    @map("created_at")
  updatedAt      DateTime    @map("updated_at")
  debtAccount    DebtAccount @relation(fields: [debtAccountId], references: [id], onDelete: Restrict)

  @@index([debtAccountId, entryDate])
  @@map("debt_entry")
}

model InventoryItemDefinition {
  id          String                @id
  name        String
  itemType    String                @map("item_type")
  unit        String?
  description String?
  isActive    Boolean               @default(true) @map("is_active")
  actorUserId String?               @map("actor_user_id")
  actorLabel  String?               @map("actor_label")
  transactionId String?             @map("transaction_id")
  createdAt   DateTime              @map("created_at")
  updatedAt   DateTime              @map("updated_at")
  entries      InventoryEntry[]

  @@index([itemType, isActive])
  @@map("inventory_item_definition")
}

model InventoryInvoiceGroup {
  id           String                    @id
  invoiceNumber String?                  @map("invoice_number")
  supplierName String?                   @map("supplier_name")
  invoiceDate  DateTime?                 @map("invoice_date")
  warehouseId  String?                   @map("warehouse_id")
  projectId    String?                   @map("project_id")
  externalCounterpartyId String?         @map("external_counterparty_id")
  grossTotalDzd Float                    @default(0) @map("gross_total_dzd")
  paidAmountDzd Float                    @default(0) @map("paid_amount_dzd")
  remainingDebtDzd Float                 @default(0) @map("remaining_debt_dzd")
  debtAccountId String?                  @map("debt_account_id")
  note         String?
  createdAt    DateTime                  @map("created_at")
  updatedAt    DateTime                  @map("updated_at")
  warehouse    Warehouse?                @relation("InventoryInvoiceGroupWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  project      Project?                  @relation("InventoryInvoiceGroupProject", fields: [projectId], references: [id], onDelete: SetNull)
  entries      InventoryEntry[]
  attachments  InventoryInvoiceAttachment[]

  @@index([warehouseId, createdAt])
  @@index([projectId, createdAt])
  @@index([externalCounterpartyId])
  @@map("inventory_invoice_group")
}

model InventoryEntry {
  id               String                   @id
  invoiceGroupId   String                   @map("invoice_group_id")
  itemDefinitionId String                   @map("item_definition_id")
  warehouseId      String?                  @map("warehouse_id")
  projectId        String?                  @map("project_id")
  itemType         String                   @map("item_type")
  itemName         String                   @map("item_name")
  unit             String?
  quantity         Float
  unitPriceDzd     Float?                   @map("unit_price_dzd")
  totalPriceDzd    Float                    @map("total_price_dzd")
  note             String?
  createdAt        DateTime                 @map("created_at")
  updatedAt        DateTime                 @map("updated_at")
  invoiceGroup     InventoryInvoiceGroup    @relation(fields: [invoiceGroupId], references: [id], onDelete: Cascade)
  itemDefinition   InventoryItemDefinition  @relation(fields: [itemDefinitionId], references: [id], onDelete: Restrict)
  warehouse        Warehouse?               @relation("InventoryEntryWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  project          Project?                 @relation("InventoryEntryProject", fields: [projectId], references: [id], onDelete: SetNull)
  assetUnits       InventoryAssetUnit[]

  @@index([invoiceGroupId, createdAt])
  @@index([itemDefinitionId])
  @@index([warehouseId])
  @@index([projectId])
  @@map("inventory_entry")
}

model InventoryAssetUnit {
  id               String          @id
  inventoryEntryId String          @map("inventory_entry_id")
  assetName        String          @map("asset_name")
  assetTag         String?         @map("asset_tag")
  serialNumber     String?         @map("serial_number")
  condition        String?
  purchaseDate     DateTime?       @map("purchase_date")
  purchasePriceDzd Float           @map("purchase_price_dzd")
  currentWarehouseId String?       @map("current_warehouse_id")
  currentProjectId String?         @map("current_project_id")
  currentLocationLabel String?     @map("current_location_label")
  note             String?
  createdAt        DateTime        @map("created_at")
  updatedAt        DateTime        @map("updated_at")
  inventoryEntry   InventoryEntry  @relation(fields: [inventoryEntryId], references: [id], onDelete: Cascade)

  @@index([inventoryEntryId, createdAt])
  @@index([assetTag])
  @@index([serialNumber])
  @@index([currentWarehouseId])
  @@index([currentProjectId])
  @@map("inventory_asset_unit")
}

model InventoryConsumableBalance {
  id String @id
  inventoryEntryId String @map("inventory_entry_id")
  itemDefinitionId String @map("item_definition_id")
  warehouseId String? @map("warehouse_id")
  projectId String? @map("project_id")
  quantity Float
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@index([inventoryEntryId])
  @@index([itemDefinitionId])
  @@index([warehouseId])
  @@index([projectId])
  @@map("inventory_consumable_balance")
}

model InventoryMovement {
  id String @id
  movementType String @map("movement_type")
  itemType String @map("item_type")
  inventoryEntryId String? @map("inventory_entry_id")
  assetUnitId String? @map("asset_unit_id")
  quantity Float
  fromWarehouseId String? @map("from_warehouse_id")
  fromProjectId String? @map("from_project_id")
  toWarehouseId String? @map("to_warehouse_id")
  toProjectId String? @map("to_project_id")
  note String?
  occurredAt DateTime @map("occurred_at")
  createdAt DateTime @map("created_at")

  @@index([inventoryEntryId, occurredAt])
  @@index([assetUnitId, occurredAt])
  @@map("inventory_movement")
}

model InventoryInvoiceAttachment {
  id            String                 @id
  invoiceGroupId String                @map("invoice_group_id")
  originalName  String                 @map("original_name")
  mimeType      String                 @map("mime_type")
  byteSize      Int                    @map("byte_size")
  storageKey    String                 @map("storage_key")
  relativePath  String                 @map("relative_path")
  sha256        String?
  createdAt     DateTime               @map("created_at")
  invoiceGroup  InventoryInvoiceGroup  @relation(fields: [invoiceGroupId], references: [id], onDelete: Cascade)

  @@unique([storageKey])
  @@index([invoiceGroupId, createdAt])
  @@map("inventory_invoice_attachment")
}
