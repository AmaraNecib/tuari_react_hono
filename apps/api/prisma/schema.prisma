generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[] @relation("AuditActor")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id          String     @id
  key         String     @unique
  name        String
  description String?
  isSystem    Boolean    @default(false) @map("is_system")
  employees   Employee[]
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([deletedAt], map: "idx_roles_deleted_at")
  @@map("roles")
}

model Employee {
  id                         String                      @id
  firstName                  String                      @map("first_name")
  lastName                   String?                     @map("last_name")
  phone                      String?
  roleId                     String                      @map("role_id")
  role                       Role                        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status                     String
  notes                      String?
  managerAssignmentsAsWorker EmployeeManagerAssignment[] @relation("EmployeeManagerWorker")
  managerAssignmentsAsManager EmployeeManagerAssignment[] @relation("EmployeeManagerManager")
  projectAssignments         EmployeeProjectAssignment[]
  managedProjects            Project[]                   @relation("ProjectManager")
  managedWarehouses          Warehouse[]                 @relation("WarehouseManager")
  deletedAt                  DateTime?                   @map("deleted_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@index([roleId], map: "idx_employees_role_id")
  @@index([status], map: "idx_employees_status")
  @@index([deletedAt], map: "idx_employees_deleted_at")
  @@map("employees")
}

model EmployeeManagerAssignment {
  id        String    @id
  workerId  String    @map("worker_id")
  worker    Employee  @relation("EmployeeManagerWorker", fields: [workerId], references: [id], onDelete: Restrict)
  managerId String    @map("manager_id")
  manager   Employee  @relation("EmployeeManagerManager", fields: [managerId], references: [id], onDelete: Restrict)
  status    String
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  notes     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([workerId, status], map: "idx_employee_manager_assignments_worker_status")
  @@index([managerId, status], map: "idx_employee_manager_assignments_manager_status")
  @@index([deletedAt], map: "idx_employee_manager_assignments_deleted_at")
  @@index([startDate], map: "idx_employee_manager_assignments_start_date")
  @@map("employee_manager_assignments")
}

model EmployeeProjectAssignment {
  id         String    @id
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  projectId  String    @map("project_id")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status     String
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  notes      String?
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, status], map: "idx_employee_project_assignments_employee_status")
  @@index([projectId, status], map: "idx_employee_project_assignments_project_status")
  @@index([deletedAt], map: "idx_employee_project_assignments_deleted_at")
  @@index([startDate], map: "idx_employee_project_assignments_start_date")
  @@map("employee_project_assignments")
}

model Project {
  id                  String                      @id
  name                String
  location            String?
  managerId           String?                     @map("manager_id")
  manager             Employee?                   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  status              String
  notes               String?
  employeeAssignments EmployeeProjectAssignment[]
  deletedAt           DateTime?                   @map("deleted_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([managerId], map: "idx_projects_manager_id")
  @@index([status], map: "idx_projects_status")
  @@index([deletedAt], map: "idx_projects_deleted_at")
  @@map("projects")
}

model Warehouse {
  id         String    @id
  name       String
  address    String?
  managerId  String?   @map("manager_id")
  manager    Employee? @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  status     String
  notes      String?
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([managerId], map: "idx_warehouses_manager_id")
  @@index([status], map: "idx_warehouses_status")
  @@index([deletedAt], map: "idx_warehouses_deleted_at")
  @@map("warehouses")
}

model AuditLog {
  id           String   @id
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  actionType   String   @map("action_type")
  summaryKey   String   @map("summary_key")
  actorUserId  String?  @map("actor_user_id")
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  occurredAt   DateTime @map("occurred_at")
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([actorUserId], map: "idx_audit_logs_actor_id")
  @@index([occurredAt], map: "idx_audit_logs_occurred_at")
  @@map("audit_logs")
}
