API_HOST=127.0.0.1
API_PORT=4318
APP_CLIENT_KEY=replace-with-a-generated-client-key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:1420,http://127.0.0.1:1420,https://tauri.localhost,tauri://localhost
# BETTER_AUTH_SECRET must be a 32+ character RANDOM secret — the placeholder
# below is rejected at startup (insufficient entropy). Generate a real one:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-32-plus-char-secret
BETTER_AUTH_URL=http://127.0.0.1:4318
APP_DB_PATH=./data/tuari.sqlite
APP_ATTACHMENTS_ROOT=./data/attachments/invoices
# Daily backups root (#430). Defaults to a sibling of the database directory
# (`./backups` here), NOT inside the data directory, so a data reset keeps the
# backups. API-side only: set an absolute path to move backups to another
# drive. The desktop shell does not forward this variable yet, so it has no
# effect on the packaged desktop app.
# APP_BACKUPS_ROOT=./backups
# Deprecated fallback only: AUTH_DB_PATH=./data/tuari.sqlite
# Optional in development; when set (or in production) it must be a 20+
# character random secret.
BOOTSTRAP_SETUP_KEY=
# The API fails CLOSED (read-only) when TUARI_LICENSE_STATUS is absent: the
# desktop shell sets it in production, but a bare `pnpm dev:api` does not.
# Set `trial` (post-install, writable) explicitly for local development.
# Values: active | trial | grace (read-only) | expired | inactive | suspicious | unknown
TUARI_LICENSE_STATUS=trial
