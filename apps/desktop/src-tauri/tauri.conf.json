{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuari",
  "version": "0.1.0",
  "identifier": "com.tuari.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @tuari/web dev",
    "beforeBuildCommand": "pnpm --filter @tuari/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Tuari Desktop",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "bin/api-runtime",
      "bin/node.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
