{
  "name": "@tuari/desktop",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "portable": "pnpm run build && node ./scripts/build-portable.mjs",
    "portable:only": "node ./scripts/build-portable.mjs",
    "test": "node --test ./scripts/*.test.mjs",
    "test:packaging-security": "node --test ./scripts/*.test.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar:build": "node ./scripts/build-sidecar.mjs",
    "typecheck": "node ./scripts/build-sidecar.mjs --allow-plaintext --ephemeral && cargo check --manifest-path ./src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "node-gyp": "^11.5.0"
  }
}
